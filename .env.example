# ========================================
# API Keys - NO subir el archivo .env real
# ========================================

# Opción 1: OpenAI (GPT-4)
OPENAI_API_KEY=sk-tu-clave-aqui

# Opción 2: Anthropic (Claude)
# ANTHROPIC_API_KEY=sk-ant-tu-clave-aqui

# ========================================
# Configuración del Modelo LLM
# ========================================
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4
MAX_TOKENS=4000
TEMPERATURE=0.7

# ========================================
# Configuración de la Aplicación
# ========================================
APP_TITLE=PEF AI Assistant
APP_SUBTITLE=Asistente inteligente para planes económico-financieros
DEBUG=False
LANGUAGE=es
